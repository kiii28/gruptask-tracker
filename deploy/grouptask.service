[Unit]
Description=GroupTask Tracker API (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/grouptask/backend
# Satu worker: data ada di memori proses, banyak worker = data tidak konsisten
ExecStart=/opt/grouptask/backend/venv/bin/gunicorn -w 1 -b 127.0.0.1:5000 app:app
# Rahasia/konfigurasi (SECRET_KEY, SMTP, GOOGLE_CLIENT_ID, APP_URL) dibaca dari sini
EnvironmentFile=-/etc/grouptask.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
